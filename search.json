---
layout: none
sitemap: false
---
[
  {%- assign hidden_slugs = site.data.hidden_posts.slugs | default: nil -%}
  {%- assign first = true -%}
  {%- for post in site.posts -%}
    {%- assign post_slug = post.title | slugify -%}
    {%- if hidden_slugs and hidden_slugs contains post_slug -%}{%- continue -%}{%- endif -%}
    {%- unless first -%},{%- endunless -%}
    {%- assign first = false %}
  {
    "title": {{ post.title | strip_html | jsonify }},
    "category": {{ post.categories | join: ", " | jsonify }},
    "tags": {{ post.tags | join: ", " | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%b %-d, %Y" | jsonify }}
  }
  {%- endfor %}
]
